@@ -0,0 +1,288 @@
+"""The cheat code's steal, played over HTTP against the real server.
+
+The server runs with a known TICTACTOE_SECRET, as production does, and its
+log is kept so the tests can read what it prints.
+"""
+
+from collections.abc import Iterator
+from pathlib import Path
+
+import pytest
+
+from .client import post, serve
+
+SECRET = "system-test-secret-0123456789abcdef"
+EMPTY = [""] * 9
+NEW_FIELDS = ("game", "stealable", "steal_used", "assisted")
+
+
+@pytest.fixture(scope="module")
+def server(tmp_path_factory: pytest.TempPathFactory) -> Iterator[tuple[str, Path]]:
+    log = tmp_path_factory.mktemp("server") / "server.log"
+    with log.open("w") as stream, serve(secret=SECRET, log=stream) as base:
+        yield base, log
+
+
+@pytest.fixture
+def url(server: tuple[str, Path]) -> str:
+    return server[0]
+
+
+def move(url: str, **body: object) -> dict:
+    """A move that must succeed; returns the answer."""
+    code, answer = post(f"{url}/api/move", body)
+    assert code == 200, answer
+    return answer
+
+
+def refused(url: str, **body: object) -> str:
+    """A move that must be refused with 400; returns the error message."""
+    code, answer = post(f"{url}/api/move", body)
+    assert code == 400, answer
+    return answer["error"]
+
+
+def hard_opening(url: str) -> dict:
+    """X 0, O 4, X 8, O 1 against Hard: stealing 4 wins, stealing 1 does not."""
+    first = move(url, board=EMPTY, cell=0, level="hard")
+    answer = move(url, board=first["board"], cell=8, level="hard", game=first["game"])
+    assert answer["board"] == ["X", "O", "", "", "O", "", "", "", "X"]
+    assert answer["stealable"] == [1, 4]
+    return answer
+
+
+# --- The steal, end to end ---------------------------------------------------
+
+
+def test_the_first_move_of_a_game_gets_a_token(url: str) -> None:
+    answer = move(url, board=EMPTY, cell=0, level="hard")
+    assert answer["game"].startswith("0.")
+    assert answer["board"][answer["computer_move"]] == "O"
+    assert answer["stealable"] == [answer["computer_move"]]
+    assert (answer["steal_used"], answer["assisted"]) == (False, False)
+
+
+def test_a_steal_that_wins_at_once_is_an_assisted_win(url: str) -> None:
+    before = hard_opening(url)
+    answer = move(url, board=before["board"], steal=4, level="hard", game=before["game"])
+    assert answer == {
+        "board": ["X", "O", "", "", "X", "", "", "", "X"],
+        "status": "won",
+        "winner": "X",
+        "line": [0, 4, 8],
+        "turn": None,
+        "computer_move": None,
+        "game": None,
+        "stealable": [],
+        "steal_used": True,
+        "assisted": True,
+    }
+
+
+def test_a_steal_is_the_players_move_and_the_computer_replies(url: str) -> None:
+    before = hard_opening(url)
+    answer = move(url, board=before["board"], steal=1, level="hard", game=before["game"])
+    assert answer["board"] == ["X", "X", "O", "", "O", "", "", "", "X"]
+    assert answer["computer_move"] == 2
+    assert (answer["status"], answer["turn"]) == ("playing", "X")
+    assert answer["game"].startswith("1.")
+    assert answer["stealable"] == []
+    assert (answer["steal_used"], answer["assisted"]) == (True, False)
+
+
+def test_after_a_steal_the_game_plays_on_to_its_end(url: str) -> None:
+    before = hard_opening(url)
+    answer = move(url, board=before["board"], steal=1, level="hard", game=before["game"])
+    while answer["status"] == "playing":
+        assert answer["steal_used"] is True
+        assert answer["stealable"] == []
+        assert answer["game"].startswith("1.")
+        cell = answer["board"].index("")
+        answer = move(url, board=answer["board"], cell=cell, level="hard", game=answer["game"])
+    assert answer["game"] is None
+    assert answer["steal_used"] is True
+    assert answer["assisted"] is (answer["winner"] == "X")
+
+
+@pytest.mark.parametrize("seed_cell", [0, 4, 8])
+def test_a_steal_works_at_easy(url: str, seed_cell: int) -> None:
+    answer = move(url, board=EMPTY, cell=seed_cell, level="easy")
+    assert answer["stealable"]
+    target = answer["stealable"][0]
+    after = move(url, board=answer["board"], steal=target, level="easy", game=answer["game"])
+    assert after["board"][target] == "X"
+    assert after["steal_used"] is True
+    if after["status"] == "playing":
+        assert after["game"].startswith("1.")
+        assert after["board"][after["computer_move"]] == "O"
+    assert after["assisted"] is (after["winner"] == "X")
+
+
+def test_the_stealable_squares_are_the_os_on_the_players_turn(url: str) -> None:
+    answer = move(url, board=EMPTY, cell=0, level="hard")
+    while answer["status"] == "playing":
+        assert answer["stealable"] == [i for i, c in enumerate(answer["board"]) if c == "O"]
+        cell = answer["board"].index("")
+        answer = move(url, board=answer["board"], cell=cell, level="hard", game=answer["game"])
+    assert answer["stealable"] == []
+    assert answer["game"] is None
+
+
+# --- Nobody can steal twice, even by hand ------------------------------------
+
+
+def test_a_second_steal_is_refused(url: str) -> None:
+    before = hard_opening(url)
+    after = move(url, board=before["board"], steal=1, level="hard", game=before["game"])
+    error = refused(url, board=after["board"], steal=4, level="hard", game=after["game"])
+    assert error == "you have already stolen a square in this game"
+
+
+def test_a_steal_needs_a_token(url: str) -> None:
+    before = hard_opening(url)
+    error = refused(url, board=before["board"], steal=4, level="hard")
+    assert error == "a steal needs the game token from the last answer"
+
+
+def test_a_stolen_board_without_its_token_is_refused(url: str) -> None:
+    before = hard_opening(url)
+    after = move(url, board=before["board"], steal=1, level="hard", game=before["game"])
+    # X - O == 1 on X's turn: only an s = 1 token makes that board legal.
+    cell = after["board"].index("")
+    assert refused(url, board=after["board"], cell=cell, level="hard") == (
+        "against the computer you play X"
+    )
+
+
+def test_the_token_is_bound_to_the_board(url: str) -> None:
+    before = hard_opening(url)
+    other = ["X", "O", "", "", "O", "", "", "X", ""]
+    error = refused(url, board=other, steal=4, level="hard", game=before["game"])
+    assert error == "the game token does not match this game"
+
+
+def test_the_token_is_bound_to_the_level(url: str) -> None:
+    before = hard_opening(url)
+    error = refused(url, board=before["board"], steal=4, level="easy", game=before["game"])
+    assert error == "the game token does not match this game"
+
+
+def test_editing_the_steal_count_breaks_the_token(url: str) -> None:
+    before = hard_opening(url)
+    after = move(url, board=before["board"], steal=1, level="hard", game=before["game"])
+    reset = "0" + after["game"][1:]
+    error = refused(url, board=after["board"], steal=4, level="hard", game=reset)
+    assert error == "the game token does not match this game"
+    raised = "1" + before["game"][1:]
+    error = refused(url, board=before["board"], cell=2, level="hard", game=raised)
+    assert error == "the game token does not match this game"
+
+
+@pytest.mark.parametrize(
+    "token",
+    ["", "0", "0.", "2." + "0" * 64, "0." + "0" * 64, "0." + "A" * 64, 0, True, ["0."], {}],
+)
+def test_a_malformed_or_forged_token_is_refused(url: str, token: object) -> None:
+    before = hard_opening(url)
+    error = refused(url, board=before["board"], steal=4, level="hard", game=token)
+    assert error == "the game token does not match this game"
+
+
+def test_a_hand_made_mid_game_board_gets_no_token(url: str) -> None:
+    board = ["X", "O", "", "", "", "", "", "", ""]
+    answer = move(url, board=board, cell=8, level="hard")
+    assert answer["status"] == "playing"
+    assert (answer["game"], answer["stealable"], answer["steal_used"]) == (None, [], False)
+
+
+def test_a_token_survives_a_restart_with_the_same_secret(url: str) -> None:
+    before = hard_opening(url)
+    with serve(secret=SECRET) as again:
+        answer = move(again, board=before["board"], steal=4, level="hard", game=before["game"])
+        assert answer["assisted"] is True
+    with serve(secret="another-secret") as other:
+        error = refused(other, board=before["board"], steal=4, level="hard", game=before["game"])
+        assert error == "the game token does not match this game"
+
+
+# --- The other refusals ------------------------------------------------------
+
+
+def test_no_steal_between_friends(url: str) -> None:
+    board = ["X", "O", "", "", "", "", "", "", ""]
+    error = refused(url, board=board, steal=1, mode="friend")
+    assert error == "you can only steal from the computer"
+
+
+def test_cell_and_steal_together_are_refused(url: str) -> None:
+    before = hard_opening(url)
+    error = refused(url, board=before["board"], cell=2, steal=4, level="hard", game=before["game"])
+    assert error == "send either cell or steal, not both"
+
+
+@pytest.mark.parametrize(
+    ("cell", "message"),
+    [
+        (2, "you can only steal one of the computer's squares"),
+        (0, "you can only steal one of the computer's squares"),
+        (9, "steal must be a whole number from 0 to 8"),
+        (-1, "steal must be a whole number from 0 to 8"),
+        (True, "steal must be a whole number from 0 to 8"),
+        ("4", "steal must be a whole number from 0 to 8"),
+        (4.0, "steal must be a whole number from 0 to 8"),
+    ],
+)
+def test_only_an_o_can_be_stolen(url: str, cell: object, message: str) -> None:
+    before = hard_opening(url)
+    assert refused(url, board=before["board"], steal=cell, level="hard", game=before["game"]) == (
+        message
+    )
+
+
+# --- The old game, unchanged -------------------------------------------------
+
+
+def test_a_friend_game_gets_no_token(url: str) -> None:
+    answer = move(url, board=EMPTY, cell=0, mode="friend")
+    assert {k: answer[k] for k in NEW_FIELDS} == {
+        "game": None,
+        "stealable": [],
+        "steal_used": False,
+        "assisted": False,
+    }
+
+
+def test_a_tokenless_game_against_hard_still_never_lets_x_win(url: str) -> None:
+    # Every opening for X, played to the end without tokens and without steals.
+    for first in range(9):
+        board, answer = EMPTY, {"status": "playing"}
+        cell = first
+        while answer["status"] == "playing":
+            answer = move(url, board=board, cell=cell, level="hard")
+            board = answer["board"]
+            cell = board.index("") if "" in board else None
+        assert answer["winner"] != "X"
+        assert answer["assisted"] is False
+
+
+def test_tokenless_errors_are_todays(url: str) -> None:
+    assert refused(url, board=["X"] + [""] * 8, cell=1) == "against the computer you play X"
+    assert refused(url, board=["O"] + [""] * 8, cell=1) == "X moves first and the players alternate"
+    assert refused(url, board=EMPTY, cell=0, level="nightmare") == (
+        "level must be one of: easy, hard"
+    )
+
+
+# --- What the server prints --------------------------------------------------
+
+
+def test_a_steal_is_logged_without_the_key_or_any_token(server: tuple[str, Path]) -> None:
+    url, log = server
+    before = hard_opening(url)
+    after = move(url, board=before["board"], steal=4, level="hard", game=before["game"])
+    assert after["status"] == "won"
+    text = log.read_text()
+    assert "steal level=hard cell=4 status=won assisted=true" in text
+    assert SECRET not in text
+    for token in (before["game"], before["game"][2:]):
+        assert token not in text
