+"""Start the real server as production does, and talk to it over HTTP."""
+
+import json
+import os
+import subprocess
+import sys
+import time
+import urllib.error
+import urllib.request
+from collections.abc import Iterator
+from contextlib import contextmanager
+from pathlib import Path
+from typing import IO
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+@contextmanager
+def serve(*, secret: str | None = None, log: IO[str] | None = None) -> Iterator[str]:
+    """Run `python3 -m tictactoe --port 0` and yield its base URL; always stop it.
+
+    `secret` is passed as TICTACTOE_SECRET (unset when None); the server's
+    stderr, where it logs, goes to `log` when given.
+    """
+    env = {k: v for k, v in os.environ.items() if k != "TICTACTOE_SECRET"}
+    if secret is not None:
+        env["TICTACTOE_SECRET"] = secret
+    process = subprocess.Popen(
+        [sys.executable, "-m", "tictactoe", "--port", "0"],
+        cwd=ROOT,
+        env=env,
+        stdout=subprocess.PIPE,
+        stderr=log,
+        text=True,
+    )
+    try:
+        assert process.stdout is not None
+        base = process.stdout.readline().split(" on ", 1)[1].strip().rstrip("/")
+        deadline = time.monotonic() + 5
+        while True:
+            try:
+                urllib.request.urlopen(f"{base}/health", timeout=1).close()
+                break
+            except OSError:
+                if time.monotonic() > deadline:
+                    raise
+                time.sleep(0.05)
+        yield base
+    finally:
+        process.terminate()
+        try:
+            process.wait(timeout=5)
+        except subprocess.TimeoutExpired:
+            process.kill()
+            process.wait()
+
+
+def get(url: str) -> tuple[int, str, str]:
+    try:
+        with urllib.request.urlopen(url, timeout=2) as response:
+            return response.status, response.headers["Content-Type"], response.read().decode()
+    except urllib.error.HTTPError as error:
+        return error.code, error.headers["Content-Type"], error.read().decode()
+
+
+def post(url: str, body: object) -> tuple[int, dict]:
+    data = json.dumps(body).encode()
+    request = urllib.request.Request(url, data, {"Content-Type": "application/json"})
+    try:
+        with urllib.request.urlopen(request, timeout=2) as response:
+            return response.status, json.load(response)
+    except urllib.error.HTTPError as error:
+        return error.code, json.load(error)
