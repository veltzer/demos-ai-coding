 import random
+from functools import cache
 
 import pytest
 
@@ -60,3 +61,73 @@ def test_unknown_level_is_rejected() -> None:
 def test_no_move_when_the_game_is_over() -> None:
     with pytest.raises(game.IllegalMoveError, match="over"):
         ai.choose_move(["X", "X", "X", "O", "O", "", "", "", ""], "hard")
+
+
+# After a steal (changes/cheat-code/spec.md, rule 7)
+
+AFTER_STEAL = ["X", "X", "", "", "O", "", "", "", "X"]  # O to move, one steal used
+
+
+@pytest.mark.parametrize("level", ai.LEVELS)
+def test_after_a_steal_the_computer_plays_as_o(level: str) -> None:
+    move = ai.choose_move(AFTER_STEAL, level, random.Random(1), steals=1)
+    assert move in game.legal_moves(AFTER_STEAL)
+    after = game.play(AFTER_STEAL, move, steals=1)
+    assert after[move] == "O"
+
+
+def test_hard_blocks_after_a_steal() -> None:
+    assert ai.choose_move(AFTER_STEAL, "hard", steals=1) == 2
+
+
+@pytest.mark.parametrize("level", ai.LEVELS)
+def test_the_computer_takes_a_win_after_a_steal(level: str) -> None:
+    cells = ["X", "X", "", "O", "O", "", "X", "X", ""]  # O wins at 5
+    assert game.turn(cells, steals=1) == "O"
+    assert ai.choose_move(cells, level, random.Random(1), steals=1) == 5
+
+
+def test_easy_plays_whole_games_after_a_steal() -> None:
+    rng = random.Random(3)
+    for _ in range(100):
+        cells = list(AFTER_STEAL)
+        while game.outcome(cells).status == "playing":
+            cells = game.play(cells, ai.choose_move(cells, "easy", rng, steals=1), steals=1)
+        assert cells.count("X") - cells.count("O") in (1, 2)
+
+
+@cache
+def reference_value(cells: tuple[str, ...]) -> int:
+    """Today's negamax, written out with today's turn rule (X when the counts are equal)."""
+    result = game.outcome(list(cells))
+    if result.status == "won":
+        return -(ai.WIN - (9 - cells.count("")))
+    if result.status == "draw":
+        return 0
+    me = "X" if cells.count("X") == cells.count("O") else "O"
+    return max(
+        -reference_value((*cells[:i], me, *cells[i + 1 :])) for i, c in enumerate(cells) if not c
+    )
+
+
+def reference_move(cells: list[str]) -> int:
+    me = "X" if cells.count("X") == cells.count("O") else "O"
+    moves = [i for i, c in enumerate(cells) if not c]
+    return max(moves, key=lambda i: (-reference_value((*cells[:i], me, *cells[i + 1 :])), -i))
+
+
+@pytest.mark.parametrize("computer", game.MARKS)
+def test_hard_without_a_steal_plays_todays_moves(computer: str) -> None:
+    seen, todo = 0, [game.new_board()]
+    while todo:
+        cells = todo.pop()
+        if game.outcome(cells).status != "playing":
+            continue
+        if game.turn(cells) == computer:
+            assert ai.choose_move(cells, "hard") == reference_move(cells)
+            assert ai.choose_move(cells, "hard", steals=0) == reference_move(cells)
+            seen += 1
+            todo.append(game.play(cells, reference_move(cells)))
+        else:
+            todo.extend(game.play(cells, move) for move in game.legal_moves(cells))
+    assert seen > 50
