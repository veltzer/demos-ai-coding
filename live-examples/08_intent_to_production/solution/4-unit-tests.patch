+
+@pytest.mark.parametrize("with_token", [False, True])
+def test_no_steal_against_a_friend(with_token: bool) -> None:
+    cells = board("XO. ... ...")
+    request = {"board": cells, "steal": 1, "mode": "friend"}
+    if with_token:
+        request["game"] = signing.sign(cells, "hard", 0)
+    with pytest.raises(game.IllegalMoveError, match="only steal from the computer"):
+        server.handle_move(request)
+
+
+@pytest.mark.parametrize(
+    "request_body",
+    [
+        {"board": EMPTY, "cell": 0, "mode": "computer", "level": "hard"},
+        {"board": board("XO. ... ..."), "cell": 8, "mode": "computer"},
