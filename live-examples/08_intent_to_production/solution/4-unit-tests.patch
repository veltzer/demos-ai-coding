+
+def test_a_hand_edited_board_breaks_the_token() -> None:
+    before = the_spec_game()
+    edited = list(before["board"])
+    edited[1] = ""
+    with pytest.raises(game.IllegalMoveError, match=MISMATCH):
+        move(edited, steal=4, game=before["game"])
+
+
+@pytest.mark.parametrize(
+    ("cells", "steals", "fields", "message"),
+    [
+        # each error of the spec's table
+        ("XO. ... ...", 0, {"cell": 2, "steal": 1}, "send either cell or steal, not both"),
+        ("XO. ... ...", None, {"steal": 1}, "a steal needs the game token from the last answer"),
+        ("XXO .O. ..X", 1, {"steal": 4}, "you have already stolen a square in this game"),
+        ("XO. ... ...", 0, {"steal": True}, "steal must be a whole number from 0 to 8"),
+        ("XO. ... ...", 0, {"steal": 9}, "steal must be a whole number from 0 to 8"),
+        ("XO. ... ...", 0, {"steal": "1"}, "steal must be a whole number from 0 to 8"),
+        ("XX. OOO X..", 0, {"steal": 3}, "the game is over"),
+        ("XO. ... ...", 0, {"steal": 0}, "you can only steal one of the computer's squares"),
+        ("XO. ... ...", 0, {"steal": 2}, "you can only steal one of the computer's squares"),
+        # the board check uses the token's steal count
+        ("XX. ... ...", 0, {"cell": 2}, "X moves first and the players alternate"),
+        ("XO. ... ...", 1, {"cell": 2}, "X moves first and the players alternate"),
+        ("X.. ... ...", 0, {"steal": 1}, "against the computer you play X"),
+        ("XX. O.. X..", 1, {"cell": 2}, "against the computer you play X"),
+    ],
+)
+def test_steal_errors(cells: str, steals: int | None, fields: dict, message: str) -> None:
+    grid = board(cells)
+    if steals is not None:
+        fields = {**fields, "game": signing.sign(grid, "hard", steals)}
+    with pytest.raises(game.IllegalMoveError, match=f"^{message}$"):
+        move(grid, **fields)
+
+
+@pytest.mark.parametrize(
+    ("request_body", "message"),
+    [
+        # today's checks come first
+        ({"board": [""] * 8, "steal": 1, "game": "bad"}, "board must be"),
+        ({"board": EMPTY, "steal": 1, "game": "bad", "mode": "online"}, "mode"),
+        ({"board": EMPTY, "steal": 1, "game": "bad", "level": "impossible"}, "level"),
+        # then the token, then the table in order
+        ({"board": board("XO. ... ..."), "cell": 2, "steal": 1, "game": "bad"}, MISMATCH),
+        ({"board": board("XO. ... ..."), "cell": 2, "steal": 1, "mode": "friend"}, "not both"),
+        ({"board": board("XO. ... ..."), "steal": 1, "mode": "friend"}, "from the computer"),
+        ({"board": board("XO. ... ..."), "steal": "x"}, "needs the game token"),
+    ],
+)
+def test_steal_errors_come_in_the_specs_order(request_body: dict, message: str) -> None:
+    with pytest.raises(game.IllegalMoveError, match=message):
+        server.handle_move(request_body)
+
+
+def test_already_stolen_comes_before_a_bad_cell_and_a_bad_cell_before_game_over() -> None:
+    cells = board("XXO .O. ..X")
+    with pytest.raises(game.IllegalMoveError, match="already stolen"):
+        move(cells, steal="x", game=signing.sign(cells, "hard", 1))
+    over = board("XX. OOO X..")
+    with pytest.raises(game.IllegalMoveError, match="whole number"):
+        move(over, steal=9, game=signing.sign(over, "hard", 0))
