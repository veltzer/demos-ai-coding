+import hashlib
+import hmac
+import importlib
+from collections.abc import Iterator
+
+import pytest
+
+from tictactoe import game, signing
+
+BOARD = ["X", "", "", "", "O", "", "", "", ""]
+MISMATCH = "the game token does not match this game"
+
+
+@pytest.fixture
+def reload_signing(monkeypatch: pytest.MonkeyPatch) -> Iterator[None]:
+    """Let a test reload signing under its own environment, then restore a fresh key."""
+    yield
+    monkeypatch.delenv("TICTACTOE_SECRET", raising=False)
+    importlib.reload(signing)
+
+
+@pytest.mark.parametrize("steals", [0, 1])
+def test_a_token_verifies_for_its_own_position(steals: int) -> None:
+    token = signing.sign(BOARD, "hard", steals)
+    assert signing.verify(token, BOARD, "hard") == steals
+
+
+def test_the_token_format() -> None:
+    token = signing.sign(BOARD, "easy", 0)
+    prefix, mac = token.split(".")
+    assert prefix == "0"
+    assert len(mac) == 64
+    assert mac == mac.lower()
+    int(mac, 16)
+
+
+def test_the_token_signs_the_documented_message(
+    monkeypatch: pytest.MonkeyPatch, reload_signing: None
+) -> None:
+    monkeypatch.setenv("TICTACTOE_SECRET", "a test key")
+    importlib.reload(signing)
+    message = b"tictactoe-game-v1|hard|1|X---O----"
+    mac = hmac.new(b"a test key", message, hashlib.sha256).hexdigest()
+    assert signing.sign(BOARD, "hard", 1) == f"1.{mac}"
+
+
+def test_tokens_survive_a_restart_with_the_same_secret(
+    monkeypatch: pytest.MonkeyPatch, reload_signing: None
+) -> None:
+    monkeypatch.setenv("TICTACTOE_SECRET", "kept across releases")
+    importlib.reload(signing)
+    token = signing.sign(BOARD, "hard", 0)
+    importlib.reload(signing)
+    assert signing.verify(token, BOARD, "hard") == 0
+
+
+@pytest.mark.parametrize("secret", [None, ""])
+def test_without_a_secret_each_start_makes_a_new_random_key(
+    monkeypatch: pytest.MonkeyPatch, reload_signing: None, secret: str | None
+) -> None:
+    if secret is None:
+        monkeypatch.delenv("TICTACTOE_SECRET", raising=False)
+    else:
+        monkeypatch.setenv("TICTACTOE_SECRET", secret)
+    importlib.reload(signing)
+    token = signing.sign(BOARD, "hard", 0)
+    empty_key = hmac.new(b"", b"tictactoe-game-v1|hard|0|X---O----", hashlib.sha256)
+    assert token != f"0.{empty_key.hexdigest()}"
+    importlib.reload(signing)
+    with pytest.raises(game.IllegalMoveError, match=MISMATCH):
+        signing.verify(token, BOARD, "hard")
+
+
+def other_board() -> list[str]:
+    cells = list(BOARD)
+    cells[8] = "X"
+    return cells
+
+
+@pytest.mark.parametrize(
+    ("board", "level"),
+    [(other_board(), "hard"), (BOARD, "easy"), (["O", *BOARD[1:]], "hard")],
+)
+def test_a_token_does_not_verify_for_another_board_or_level(board: list[str], level: str) -> None:
+    token = signing.sign(BOARD, "hard", 0)
+    with pytest.raises(game.IllegalMoveError, match=MISMATCH):
+        signing.verify(token, board, level)
+
+
+def test_changing_the_steal_count_breaks_the_token() -> None:
+    zero, one = signing.sign(BOARD, "hard", 0), signing.sign(BOARD, "hard", 1)
+    for forged in ("1" + zero[1:], "0" + one[1:]):
+        with pytest.raises(game.IllegalMoveError, match=MISMATCH):
+            signing.verify(forged, BOARD, "hard")
+
+
+def malformed() -> list[object]:
+    good = signing.sign(BOARD, "hard", 0)
+    return [
+        None,
+        0,
+        ["0", good[2:]],
+        "",
+        "0",
+        "0.",
+        good.upper(),
+        "2" + good[1:],
+        "00" + good[1:],
+        good + "0",
+        good[:-1],
+        good + "\n",
+        " " + good,
+        good.replace(".", ":"),
+    ]
+
+
+@pytest.mark.parametrize("token", malformed())
+def test_malformed_tokens_are_rejected(token: object) -> None:
+    with pytest.raises(game.IllegalMoveError, match=MISMATCH):
+        signing.verify(token, BOARD, "hard")
+
+
+def test_the_key_never_appears_in_a_token_or_an_error(
+    monkeypatch: pytest.MonkeyPatch, reload_signing: None
+) -> None:
+    monkeypatch.setenv("TICTACTOE_SECRET", "s3cret-key-value")
+    importlib.reload(signing)
+    token = signing.sign(BOARD, "hard", 0)
+    assert "s3cret" not in token
+    with pytest.raises(game.IllegalMoveError) as error:
+        signing.verify("1" + token[1:], BOARD, "hard")
+    assert "s3cret" not in str(error.value)
