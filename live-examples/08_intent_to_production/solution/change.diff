+    importlib.reload(signing)
+    message = b"tictactoe-game-v1|hard|1|X---O----"
+    mac = hmac.new(b"a test key", message, hashlib.sha256).hexdigest()
+    assert signing.sign(BOARD, "hard", 1) == f"1.{mac}"
+
+
+def test_tokens_survive_a_restart_with_the_same_secret(
+    monkeypatch: pytest.MonkeyPatch, reload_signing: None
+) -> None:
+    monkeypatch.setenv("TICTACTOE_SECRET", "kept across releases")
+    importlib.reload(signing)
+    token = signing.sign(BOARD, "hard", 0)
+    importlib.reload(signing)
+    assert signing.verify(token, BOARD, "hard") == 0
+
+
+@pytest.mark.parametrize("secret", [None, ""])
+def test_without_a_secret_each_start_makes_a_new_random_key(
