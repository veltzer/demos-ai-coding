+@cache
+def reference_value(cells: tuple[str, ...]) -> int:
+    """Today's negamax, written out with today's turn rule (X when the counts are equal)."""
+    result = game.outcome(list(cells))
+    if result.status == "won":
+        return -(ai.WIN - (9 - cells.count("")))
+    if result.status == "draw":
+        return 0
+    me = "X" if cells.count("X") == cells.count("O") else "O"
+    return max(
+        -reference_value((*cells[:i], me, *cells[i + 1 :])) for i, c in enumerate(cells) if not c
+    )
