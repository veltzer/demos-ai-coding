+def check_mode(request: dict, board: list[str], judged: bool) -> tuple[str, str]:
+    """Check the mode and level, and that a token comes only with the computer."""
+    mode = request.get("mode", "computer")
+    if mode not in MODES:
+        raise game.IllegalMoveError(f"mode must be one of: {', '.join(MODES)}")
+    level = request.get("level", "hard")
+    if mode == "computer":
+        if level not in ai.LEVELS:
+            raise game.IllegalMoveError(f"level must be one of: {', '.join(ai.LEVELS)}")
+        if not judged and game.turn(board) != "X":
+            raise game.IllegalMoveError("against the computer you play X")
+    elif request.get("game") is not None:
+        # Friend mode never hands out a token, so one sent here is not ours.
+        raise game.IllegalMoveError("the game token is only for games against the computer")
+    return mode, level
+
+
